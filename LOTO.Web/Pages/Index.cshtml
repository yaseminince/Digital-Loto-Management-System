@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<div class="welcome-page">

    <!-- =========================
         HERO SECTION
         ========================= -->

    <section class="hero-section">

        <!-- LEFT SIDE -->

        <div class="hero-left">

            <div class="hero-content">

                <!-- BRAND -->

                <div class="brand">

                    <div class="brand-icon">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <div>
                        <div class="system-name">
                            DIGITAL LOTO
                        </div>

                        <div class="system-subtitle">
                            MANAGEMENT SYSTEM
                        </div>
                    </div>

                </div>


                <!-- INTRO -->

                <div class="intro">

                    <div class="eyebrow">
                        LOCKOUT / TAGOUT • SAFETY MANAGEMENT
                    </div>

                    <h1>
                        Safety starts with
                        <span>proper isolation.</span>
                    </h1>

                    <p>
                        Digital LOTO provides a simple and secure way
                        to manage Lockout / Tagout operations, track
                        LOTO records and keep users informed.
                    </p>

                </div>


                <!-- FEATURES -->

                <div class="feature-list">

                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div class="feature-text">

                            <h3>
                                Secure Operations
                            </h3>

                            <p>
                                Manage LOTO operations safely
                                and systematically.
                            </p>

                        </div>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-clipboard-check"></i>
                        </div>

                        <div class="feature-text">

                            <h3>
                                Complete Tracking
                            </h3>

                            <p>
                                Track active, completed and
                                overdue LOTO records.
                            </p>

                        </div>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon">
                            <i class="bi bi-bell"></i>
                        </div>

                        <div class="feature-text">

                            <h3>
                                Smart Notifications
                            </h3>

                            <p>
                                Stay informed about important
                                LOTO activities.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- QUOTE -->

                <div class="safety-quote">

                    <i class="bi bi-quote"></i>

                    <div>

                        <p>
                            A safer workplace starts with proper control.
                        </p>

                        <span>
                            SAFETY • CONTROL • ACCOUNTABILITY
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->

        <div class="hero-right">

            <div class="circle circle-top"></div>
            <div class="circle circle-bottom"></div>


            <!-- SYSTEM STATUS -->

            <div class="system-status">

                <span class="status-dot"></span>

                SYSTEM ONLINE

            </div>


            <!-- LOGIN AREA -->

            <div class="login-area">

                <div class="login-icon">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>

                <div class="access-label">
                    ACCESS YOUR SYSTEM
                </div>

                <h2>
                    Welcome back
                </h2>

                <p>
                    Sign in to access your Digital LOTO dashboard.
                </p>


                <div class="login-buttons">

                    <a asp-page="/Login/Index"
                       class="btn-login">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Login

                    </a>


                    <div class="divider">

                        <span>OR</span>

                    </div>


                    <a asp-page="/Register/Index"
                       class="btn-register">

                        <i class="bi bi-person-plus"></i>

                        Create an Account

                    </a>

                </div>

            </div>


            <!-- SECURITY -->

            <div class="security-note">

                <i class="bi bi-shield-lock"></i>

                <div>
                    <strong>Secure access</strong>
                    <span>
                        Your data is protected.
                    </span>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         HOW IT WORKS
         ========================= -->

    <section class="how-section">

        <div class="how-header">

            <div class="eyebrow">
                HOW DIGITAL LOTO WORKS
            </div>

            <h2>
                A safer process in three simple steps
            </h2>

        </div>


        <div class="steps">

            <!-- STEP 1 -->

            <div class="step-card">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>

                <div class="step-text">

                    <h3>
                        Create LOTO
                    </h3>

                    <p>
                        Start a new Lockout / Tagout operation
                        with the required information.
                    </p>

                </div>

            </div>


            <div class="step-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>


            <!-- STEP 2 -->

            <div class="step-card">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">
                    <i class="bi bi-eye"></i>
                </div>

                <div class="step-text">

                    <h3>
                        Manage & Monitor
                    </h3>

                    <p>
                        Track active operations, monitor statuses
                        and receive notifications.
                    </p>

                </div>

            </div>


            <div class="step-arrow">
                <i class="bi bi-arrow-right"></i>
            </div>


            <!-- STEP 3 -->

            <div class="step-card">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="step-text">

                    <h3>
                        Close Safely
                    </h3>

                    <p>
                        Complete the operation when work is finished
                        and keep the record.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="welcome-footer">

        <div class="footer-brand">

            <div class="footer-icon">
                <i class="bi bi-lock-fill"></i>
            </div>

            <div>

                <strong>
                    DIGITAL LOTO
                </strong>

                <span>
                    MANAGEMENT SYSTEM
                </span>

            </div>

        </div>


        <div class="footer-center">

            Safety
            <span>•</span>
            Control
            <span>•</span>
            Accountability

            <small>
                © 2026 Digital LOTO Management System
            </small>

        </div>


        <div class="footer-right">

            A safer tomorrow
            <br />
            starts today.

        </div>

    </footer>

</div>


<style>

    * {
        box-sizing: border-box;
    }


    html,
    body {
        margin: 0;
        padding: 0;
    }


    /* =====================================
           PAGE
           ===================================== */

    .welcome-page {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient( 135deg, #f4f7fa 0%, #ffffff 50%, #eef3f7 100% );
        color: #062d4d;
    }


    /* =====================================
           HERO
           ===================================== */

    .hero-section {
        width: 100%;
        min-height: 100vh;
        display: grid;
        grid-template-columns: 60% 40%;
    }


    /* =====================================
           LEFT
           ===================================== */

    .hero-left {
        display: flex;
        align-items: center;
        padding: 70px 7%;
        background: #ffffff;
    }


    .hero-content {
        width: 100%;
        max-width: 850px;
        margin-left: auto;
    }


    /* BRAND */

    .brand {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    .brand-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #062d4d;
        color: white;
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(6, 45, 77, 0.15);
    }


    .system-name {
        color: #062d4d;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .system-subtitle {
        margin-top: 3px;
        color: #8a96a5;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 3px;
    }


    /* INTRO */

    .intro {
        margin-top: 75px;
    }


    .eyebrow {
        margin-bottom: 18px;
        color: #1688e8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .intro h1 {
        max-width: 750px;
        margin: 0;
        color: #062d4d;
        font-size: clamp(42px, 4.2vw, 64px);
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -2px;
    }


        .intro h1 span {
            display: block;
            color: #1688e8;
        }


    .intro p {
        max-width: 700px;
        margin: 25px 0 0;
        color: #718096;
        font-size: 15px;
        line-height: 1.8;
    }


    /* =====================================
           FEATURES
           ===================================== */

    .feature-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 42px;
    }


    .feature-card {
        min-height: 135px;
        padding: 21px;
        border-radius: 13px;
        background: #f7f9fb;
        border: 1px solid #e5ebf0;
        transition: all 0.2s ease;
    }


        .feature-card:hover {
            transform: translateY(-3px);
            border-color: #d6e1e9;
            box-shadow: 0 10px 25px rgba(6, 45, 77, 0.06);
        }


    .feature-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        border-radius: 9px;
        background: #e7eef4;
        color: #062d4d;
        font-size: 19px;
    }


    .feature-card h3 {
        margin: 0 0 7px;
        color: #062d4d;
        font-size: 12px;
        font-weight: 800;
    }


    .feature-card p {
        margin: 0;
        color: #84909d;
        font-size: 9px;
        line-height: 1.55;
    }


    /* =====================================
           QUOTE
           ===================================== */

    .safety-quote {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 23px;
        border-top: 1px solid #edf0f3;
    }


        .safety-quote > i {
            color: #ccd8e1;
            font-size: 38px;
        }


        .safety-quote p {
            margin: 0 0 6px;
            color: #718096;
            font-size: 11px;
            font-style: italic;
        }


        .safety-quote span {
            color: #9ba6b2;
            font-size: 7px;
            font-weight: 800;
            letter-spacing: 2px;
        }


    /* =====================================
           RIGHT
           ===================================== */

    .hero-right {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 35px 7% 35px;
        background: #062d4d;
        color: white;
    }


    /* DECORATIVE CIRCLES */

    .circle {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.06);
        pointer-events: none;
    }


    .circle-top {
        width: 500px;
        height: 500px;
        top: -330px;
        right: -270px;
    }


    .circle-bottom {
        width: 400px;
        height: 400px;
        bottom: -290px;
        left: -260px;
    }


    /* STATUS */

    .system-status {
        position: relative;
        z-index: 2;
        align-self: flex-end;
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255,255,255,0.62);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #5bd18c;
        box-shadow: 0 0 0 4px rgba(91,209,140,0.12);
    }


    /* LOGIN */

    .login-area {
        width: 100%;
        max-width: 380px;
        position: relative;
        z-index: 2;
        text-align: center;
    }


    .login-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 28px;
        border-radius: 19px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.12);
        font-size: 34px;
    }


    .access-label {
        margin-bottom: 10px;
        color: rgba(255,255,255,0.55);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .login-area h2 {
        margin: 0;
        color: white;
        font-size: 36px;
        font-weight: 800;
    }


    .login-area > p {
        margin: 13px auto 32px;
        max-width: 320px;
        color: rgba(255,255,255,0.62);
        font-size: 12px;
        line-height: 1.7;
    }


    /* BUTTONS */

    .login-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


        .login-buttons a {
            width: 100%;
            height: 51px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border-radius: 9px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            transition: all 0.2s ease;
        }


    .btn-login {
        background: white;
        color: #062d4d;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }


        .btn-login:hover {
            background: #f2f6f9;
            color: #062d4d;
            transform: translateY(-2px);
        }


    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255,255,255,0.35);
        font-size: 8px;
        font-weight: 700;
    }


        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,0.14);
        }


    .btn-register {
        background: transparent;
        color: white;
        border: 1px solid rgba(255,255,255,0.42);
    }


        .btn-register:hover {
            background: rgba(255,255,255,0.08);
            color: white;
            border-color: white;
            transform: translateY(-2px);
        }


    /* SECURITY */

    .security-note {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 9px;
        color: rgba(255,255,255,0.48);
        font-size: 8px;
        text-align: left;
    }


        .security-note i {
            font-size: 19px;
            color: rgba(255,255,255,0.55);
        }


        .security-note strong,
        .security-note span {
            display: block;
        }


        .security-note strong {
            color: rgba(255,255,255,0.65);
            font-size: 8px;
            margin-bottom: 2px;
        }


    /* =====================================
           HOW IT WORKS
           ===================================== */

    .how-section {
        width: 100%;
        padding: 80px 7%;
        background: #f7f9fb;
        border-top: 1px solid #e5ebf0;
    }


    .how-header {
        text-align: center;
        margin-bottom: 40px;
    }


        .how-header .eyebrow {
            margin-bottom: 8px;
        }


        .how-header h2 {
            margin: 0;
            color: #062d4d;
            font-size: 32px;
            font-weight: 800;
        }


    .steps {
        max-width: 1250px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 18px;
    }


    .step-card {
        min-height: 145px;
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 25px;
        background: white;
        border: 1px solid #e4eaf0;
        border-radius: 14px;
        box-shadow: 0 7px 22px rgba(6,45,77,0.04);
    }


    .step-number {
        min-width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f3fc;
        color: #1688e8;
        font-size: 11px;
        font-weight: 800;
    }


    .step-icon {
        min-width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf1f4;
        color: #062d4d;
        font-size: 21px;
    }


    .step-text h3 {
        margin: 0 0 7px;
        color: #062d4d;
        font-size: 13px;
        font-weight: 800;
    }


    .step-text p {
        margin: 0;
        color: #84909d;
        font-size: 10px;
        line-height: 1.6;
    }


    .step-arrow {
        color: #9aa9b6;
        font-size: 22px;
    }


    /* =====================================
           FOOTER
           ===================================== */

    .welcome-footer {
        width: 100%;
        padding: 25px 7%;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        background: white;
        border-top: 1px solid #e5ebf0;
    }


    .footer-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .footer-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #062d4d;
        color: white;
        font-size: 14px;
    }


    .footer-brand strong {
        display: block;
        color: #062d4d;
        font-size: 10px;
        letter-spacing: 1px;
    }


    .footer-brand span {
        display: block;
        margin-top: 2px;
        color: #9aa5b2;
        font-size: 6px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }


    .footer-center {
        text-align: center;
        color: #718096;
        font-size: 9px;
        font-weight: 600;
    }


        .footer-center span {
            color: #1688e8;
        }


        .footer-center small {
            display: block;
            margin-top: 5px;
            color: #a0aab5;
            font-size: 7px;
            font-weight: 400;
        }


    .footer-right {
        text-align: right;
        color: #84909d;
        font-size: 9px;
        line-height: 1.5;
    }


    /* =====================================
           RESPONSIVE
           ===================================== */

    @@media (max-width: 1000px) {

        .hero-section {
            grid-template-columns: 1fr;
        }


        .hero-left {
            min-height: auto;
            padding: 60px 8%;
        }


        .hero-right {
            min-height: 600px;
        }


        .feature-list {
            grid-template-columns: repeat(3, 1fr);
        }


        .steps {
            grid-template-columns: 1fr;
        }


        .step-arrow {
            display: none;
        }
    }


    @@media (max-width: 650px) {

        .hero-left {
            padding: 45px 25px;
        }


        .hero-right {
            min-height: 560px;
            padding: 30px 25px;
        }


        .intro {
            margin-top: 55px;
        }


            .intro h1 {
                font-size: 38px;
            }


        .feature-list {
            grid-template-columns: 1fr;
        }


        .feature-card {
            min-height: auto;
        }


        .how-section {
            padding: 60px 25px;
        }


        .how-header h2 {
            font-size: 25px;
        }


        .welcome-footer {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 25px;
        }


        .footer-brand,
        .footer-center,
        .footer-right {
            justify-content: center;
            text-align: center;
        }
    }

</style>