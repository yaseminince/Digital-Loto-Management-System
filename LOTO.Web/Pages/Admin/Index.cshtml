@page
@model LOTO.Web.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}


<div class="dashboard-container">

    <!-- HEADER -->

    <div class="dashboard-header">

        <div>

            <h1>
                Admin Dashboard
            </h1>

            <p>
                LOTO management overview
            </p>

        </div>


        <div class="current-date">

            <i class="bi bi-calendar3"></i>

            @DateTime.Now.ToString("dd MMMM yyyy")

        </div>

    </div>


    <!-- STAT CARDS -->

    <div class="stats-grid">


        <!-- ACTIVE -->

        <div class="stat-card">

            <div class="stat-icon active-icon">

                <i class="bi bi-unlock"></i>

            </div>

            <div class="stat-content">

                <span>
                    ACTIVE LOTO
                </span>

                <strong>
                    @Model.ActiveLoto
                </strong>

            </div>

        </div>


        <!-- CLOSED -->

        <div class="stat-card">

            <div class="stat-icon closed-icon">

                <i class="bi bi-check-circle"></i>

            </div>

            <div class="stat-content">

                <span>
                    CLOSED LOTO
                </span>

                <strong>
                    @Model.ClosedLoto
                </strong>

            </div>

        </div>


        <!-- OVERDUE -->

        <div class="stat-card">

            <div class="stat-icon overdue-icon">

                <i class="bi bi-exclamation-triangle"></i>

            </div>

            <div class="stat-content">

                <span>
                    OVERDUE LOTO
                </span>

                <strong>
                    @Model.OverdueLoto
                </strong>

            </div>

        </div>


        <!-- TODAY -->

        <div class="stat-card">

            <div class="stat-icon today-icon">

                <i class="bi bi-calendar-day"></i>

            </div>

            <div class="stat-content">

                <span>
                    TODAY'S LOTO
                </span>

                <strong>
                    @Model.TodaysLoto
                </strong>

            </div>

        </div>


        <!-- TODAY CLOSED -->

        <div class="stat-card">

            <div class="stat-icon today-closed-icon">

                <i class="bi bi-calendar-check"></i>

            </div>

            <div class="stat-content">

                <span>
                    TODAY'S CLOSED
                </span>

                <strong>
                    @Model.TodaysClosedLoto
                </strong>

            </div>

        </div>


    </div>


    <!-- CHARTS -->

    <div class="charts-grid">


        <!-- STATUS -->

        <div class="chart-card">

            <div class="chart-header">

                <h2>
                    LOTO BY STATUS
                </h2>

                <p>
                    Current LOTO status distribution
                </p>

            </div>


            <div class="chart-container">

                <canvas id="lotoStatusChart"></canvas>

            </div>

        </div>


        <!-- DEPARTMENT -->

        <div class="chart-card">

            <div class="chart-header">

                <h2>
                    LOTO BY DEPARTMENT
                </h2>

                <p>
                    Active and closed LOTO by department
                </p>

            </div>


            <div class="chart-container">

                <canvas id="departmentChart"></canvas>

            </div>

        </div>


        <!-- EQUIPMENT -->

        <div class="chart-card">

            <div class="chart-header">

                <h2>
                    LOTO BY EQUIPMENT (ACTIVE)
                </h2>

                <p>
                    Most frequently used equipment
                </p>

            </div>


            <div class="chart-container">

                <canvas id="equipmentChart"></canvas>

            </div>

        </div>


    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>


    // =====================================================
    // STATUS CHART
    // =====================================================

    const statusCtx =
        document.getElementById('lotoStatusChart');


    new Chart(statusCtx, {

        type: 'pie',

        data: {

            labels: [
                'Active',
                'Closed',
                'Overdue'
            ],

            datasets: [{

                data: [

                        @Model.ActiveLoto,

                        @Model.ClosedLoto,

                    @Model.OverdueLoto

                ],

                backgroundColor: [

                    '#20a464',

                    '#2478d1',

                    '#e89024'

                ],

                borderWidth: 0

            }]

        },


        options: {

            responsive: true,

            maintainAspectRatio: false,


            plugins: {

                legend: {

                    position: 'bottom',

                    labels: {

                        boxWidth: 12,

                        font: {

                            size: 11

                        }

                    }

                }

            }

        }

    });



    // =====================================================
    // DEPARTMENT CHART
    // ACTIVE + CLOSED
    // =====================================================


    const departmentLabels = [

            @foreach (var item in Model.DepartmentStatistics)
        {
            @: "@item.DepartmentName",
        }

        ];


    const departmentActiveData = [

            @foreach (var item in Model.DepartmentStatistics)
        {
            @: @item.ActiveCount,
        }

        ];


    const departmentClosedData = [

            @foreach (var item in Model.DepartmentStatistics)
        {
            @: @item.ClosedCount,
        }

        ];


    const departmentCtx =
        document.getElementById('departmentChart');


    new Chart(departmentCtx, {

        type: 'bar',

        data: {

            labels: departmentLabels,

            datasets: [

                {

                    label: 'Active',

                    data: departmentActiveData,

                    backgroundColor: '#20a464',

                    borderRadius: 3

                },

                {

                    label: 'Closed',

                    data: departmentClosedData,

                    backgroundColor: '#2478d1',

                    borderRadius: 3

                }

            ]

        },


        options: {

            responsive: true,

            maintainAspectRatio: false,


            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0,

                        font: {

                            size: 9

                        }

                    }

                },


                x: {

                    ticks: {

                        font: {

                            size: 9

                        }

                    }

                }

            },


            plugins: {

                legend: {

                    display: true,

                    position: 'bottom',

                    labels: {

                        boxWidth: 12,

                        font: {

                            size: 10

                        }

                    }

                }

            }

        }

    });



    // =====================================================
    // EQUIPMENT CHART
    // ACTIVE ONLY
    // =====================================================


    const equipmentLabels = [

            @foreach (var item in Model.EquipmentStatistics)
        {
            @: "@item.EquipmentName",
        }

        ];


    const equipmentData = [

            @foreach (var item in Model.EquipmentStatistics)
        {
            @: @item.Count,
        }

        ];


    const equipmentCtx =
        document.getElementById('equipmentChart');


    new Chart(equipmentCtx, {

        type: 'bar',

        data: {

            labels: equipmentLabels,

            datasets: [{

                label: 'Active',

                data: equipmentData,

                backgroundColor: '#20a464',

                borderRadius: 3,

                barThickness : 35

            }]

        },


        options: {

            indexAxis: 'y',

            responsive: true,

            maintainAspectRatio: false,


            scales: {

                x: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0,

                        font: {

                            size: 9

                        }

                    }

                },


                y: {

                    ticks: {

                        font: {

                            size: 9

                        }

                    }

                }

            },


            plugins: {

                legend: {

                    display: false

                }

            }

        }

    });


</script>


<style>

    * {
        box-sizing: border-box;
    }


    /* =========================
           DASHBOARD
           ========================= */

    .dashboard-container {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 20px 24px;
        background: #f6f8fb;
        min-height: 100vh;
        overflow-x: hidden;
    }


    /* =========================
           HEADER
           ========================= */

    .dashboard-header {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }


        .dashboard-header h1 {
            margin: 0;
            color: #172b4d;
            font-size: 25px;
            font-weight: 700;
        }


        .dashboard-header p {
            margin: 3px 0 0;
            color: #7b8794;
            font-size: 12px;
        }


    .current-date {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #6b778c;
        font-size: 12px;
    }


    /* =========================
           STAT CARDS
           ========================= */

    .stats-grid {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }


    .stat-card {
        min-width: 0;
        background: white;
        border-radius: 9px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #edf0f4;
        box-shadow: 0 2px 7px rgba(23, 43, 77, 0.05);
    }


    .stat-icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }


    .stat-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }


        .stat-content span {
            font-size: 9px;
            font-weight: 600;
            color: #7b8794;
            white-space: nowrap;
        }


        .stat-content strong {
            font-size: 21px;
            line-height: 1;
            color: #172b4d;
        }


    .active-icon {
        background: #e8f7ef;
        color: #20a464;
    }


    .closed-icon {
        background: #e9f1fb;
        color: #2478d1;
    }


    .overdue-icon {
        background: #fff2df;
        color: #e89024;
    }


    .today-icon {
        background: #eeeafd;
        color: #6d5dd3;
    }


    .today-closed-icon {
        background: #e8f4f7;
        color: #23869b;
    }


    /* =========================
           CHARTS
           ========================= */

    .charts-grid {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }


    .chart-card {
        min-width: 0;
        width: 100%;
        background: white;
        border-radius: 9px;
        padding: 16px;
        border: 1px solid #edf0f4;
        box-shadow: 0 2px 7px rgba(23, 43, 77, 0.05);
    }


    .chart-header {
        margin-bottom: 8px;
    }


        .chart-header h2 {
            margin: 0;
            color: #172b4d;
            font-size: 12px;
            font-weight: 700;
        }


        .chart-header p {
            margin: 3px 0 0;
            color: #8a94a6;
            font-size: 9px;
        }


    .chart-container {
        width: 100%;
        height: 235px;
        min-width: 0;
        position: relative;
    }


    canvas {
        max-width: 100% !important;
    }


    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1100px) {

        .stats-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }


        .charts-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 750px) {

        .dashboard-container {
            padding: 15px;
        }


        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }


        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }


        .charts-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 450px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }

</style>