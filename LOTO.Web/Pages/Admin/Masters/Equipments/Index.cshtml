@page
@model LOTO.Web.Pages.Admin.Masters.Equipment.IndexModel

@{
    ViewData["Title"] = "Equipment";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1" style="color: #0b2d4d;">
            Equipment
        </h2>

        <p class="text-muted mb-0">
            Manage equipment records
        </p>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold" style="color: #0b2d4d;">

                @if (Model.IsEditMode)
                {
                    <span>Edit Equipment</span>
                }
                else
                {
                    <span>Add Equipment</span>
                }

            </h5>

        </div>


        <div class="card-body">

            @if (Model.IsEditMode)
            {
                <form method="post" asp-page-handler="Update">

                    <input type="hidden" asp-for="Equipment.Id" />

                    <div class="row align-items-end">

                        <div class="col-md-8">

                            <label asp-for="Equipment.Name"
                                   class="form-label fw-semibold">
                                Equipment Name
                            </label>

                            <input asp-for="Equipment.Name"
                                   class="form-control"
                                   placeholder="Enter equipment name" />

                            <span asp-validation-for="Equipment.Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4 d-flex gap-2">

                            <button type="submit"
                                    class="btn text-white px-4"
                                    style="background-color: #0b2d4d;">
                                Update Equipment
                            </button>

                            <a asp-page="/Admin/Masters/Equipment/Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                        </div>

                    </div>

                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Add">

                    <div class="row align-items-end">

                        <div class="col-md-8">

                            <label asp-for="Equipment.Name"
                                   class="form-label fw-semibold">
                                Equipment Name
                            </label>

                            <input asp-for="Equipment.Name"
                                   class="form-control"
                                   placeholder="Enter equipment name" />

                            <span asp-validation-for="Equipment.Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <button type="submit"
                                    class="btn text-white px-4"
                                    style="background-color: #0b2d4d;">
                                Add Equipment
                            </button>

                        </div>

                    </div>

                </form>
            }

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold"
                    style="color: #0b2d4d;">
                    Equipment
                </h5>

                <span class="text-muted small">
                    @Model.Equipments.Count equipment(s)
                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table id="equipmentTable"
                   class="table table-hover align-middle mb-0">

                <thead style="background-color: #f8fafc;">

                    <tr>

                        <th class="px-4 py-3 small text-uppercase text-muted">
                            Name
                        </th>

                        <th class="py-3 small text-uppercase text-muted">
                            Status
                        </th>

                        <th class="py-3 small text-uppercase text-muted">
                            Created
                        </th>

                        <th class="py-3 pe-4 small text-uppercase text-muted">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Equipments.Any())
                    {
                        foreach (var equipment in Model.Equipments)
                        {
                            <tr>

                                <td class="px-4">

                                    <span class="fw-semibold"
                                          style="color: #0b2d4d;">
                                        @equipment.Name
                                    </span>

                                </td>


                                <td>

                                    @if (equipment.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <td data-order="@equipment.CreatedDate.ToString("yyyy-MM-dd")">

                                    @equipment.CreatedDate.ToString("dd.MM.yyyy")

                                </td>


                                <td class="pe-4">

                                    <div class="d-flex gap-2">

                                        <form method="post"
                                              asp-page-handler="Edit">

                                            <input type="hidden"
                                                   name="equipmentId"
                                                   value="@equipment.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </button>

                                        </form>


                                        <form method="post"
                                              asp-page-handler="ChangeStatus">

                                            <input type="hidden"
                                                   name="equipmentId"
                                                   value="@equipment.Id" />

                                            @if (equipment.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Activate
                                                </button>
                                            }

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>


            @if (!Model.Equipments.Any())
            {
                <div class="text-center py-5 text-muted">

                    <div class="fw-semibold">
                        No equipment found
                    </div>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">

    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function() {
            new DataTable('#equipmentTable', {
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[2, 'desc']],
                columnDefs: [
                    {
                        orderable: false,
                        targets: [3]
                    }
                ],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ records",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    infoEmpty: "Showing 0 to 0 of 0 records",
                    zeroRecords: "No matching records found",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }

                }

            });

        });


        @if (Model.ShowSuccessMessage)
            {
                <text>

                        Swal.fire({
                            icon: "success",
                        title: "Success!",
                        text: "@Model.SuccessMessage"
                                });

                </text>
        }

    </script>

}