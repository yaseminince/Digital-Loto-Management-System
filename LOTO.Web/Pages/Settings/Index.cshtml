@page
@model LOTO.Web.Pages.Settings.IndexModel

@{
    ViewData["Title"] = "Settings";
}


<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="mb-4">

        <h2 class="fw-bold">
            Settings
        </h2>

        <p class="text-muted mb-0">
            Manage your account settings.
        </p>

    </div>



    <!-- ACCOUNT INFORMATION -->

    <div class="card shadow-sm mb-4"
         style="max-width: 700px;">

        <div class="card-body">

            <h5 class="fw-bold mb-4">
                Account Information
            </h5>


            <div class="row mb-3">

                <div class="col-md-4 text-muted">
                    Name
                </div>

                <div class="col-md-8 fw-semibold">
                    @Model.UserAccount?.Name
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 text-muted">
                    Email
                </div>

                <div class="col-md-8 fw-semibold">
                    @Model.UserAccount?.Email
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 text-muted">
                    Role
                </div>

                <div class="col-md-8 fw-semibold">
                    @Model.UserAccount?.Role?.Name
                </div>

            </div>


            <div class="row">

                <div class="col-md-4 text-muted">
                    Account Status
                </div>

                <div class="col-md-8">

                    @if (Model.UserAccount?.IsActive == true)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactive
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>



    <!-- CHANGE PASSWORD -->

    <div class="card shadow-sm"
         style="max-width: 700px;">

        <div class="card-body">

            <h5 class="fw-bold mb-4">
                Change Password
            </h5>


            <form method="post"
                  asp-page-handler="ChangePassword">


                <!-- CURRENT PASSWORD -->

                <div class="mb-3">

                    <label asp-for="CurrentPassword"
                           class="form-label">

                        Current Password

                    </label>


                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control" />


                    <span asp-validation-for="CurrentPassword"
                          class="text-danger">

                    </span>

                </div>



                <!-- NEW PASSWORD -->
                <!-- NEW PASSWORD -->

                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="form-label">

                        New Password

                    </label>


                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control" />


                    <div class="form-text">
                        Password must contain at least 6 characters,
                        1 uppercase letter, 1 lowercase letter,
                        1 number, and 1 special character.
                    </div>


                    <span asp-validation-for="NewPassword"
                          class="text-danger">

                    </span>

                </div>



                <!-- CONFIRM PASSWORD -->

                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">

                        Confirm New Password

                    </label>


                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control" />


                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">

                    </span>

                </div>



                <!-- BUTTON -->

                <button type="submit"
                        class="btn btn-primary">

                    Change Password

                </button>


            </form>

        </div>

    </div>

</div>



<!-- SWEETALERT -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@if (Model.ShowSuccessMessage)
{
    <script>

        Swal.fire({

            icon: 'success',

            title: 'Success!',

            text: '@Model.SuccessMessage',

            confirmButtonText: 'OK'

        });

    </script>
}


<partial name="_ValidationScriptsPartial" />