@page
@model LOTO.Web.Pages.Loto.MyActiveModel
@using LOTO.Domain.Enums

@{
    ViewData["Title"] = "My Active LOTOs";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1" style="color: #0b2d4d;">
            My Active LOTOs
        </h2>

        <p class="text-muted mb-0">
            View your active and overdue LOTO records
        </p>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold" style="color: #0b2d4d;">
                    My LOTOs
                </h5>

                <span class="text-muted small">
                    @Model.Lotos.Count record(s)
                </span>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            @if (Model.Lotos.Any())
            {
                <table id="myActiveTable"
                       class="table table-hover align-middle mb-0">

                    <thead style="background-color: #f8fafc;">

                        <tr>

                            <th class="px-4 py-3 small text-uppercase text-muted">
                                LOTO
                            </th>

                            <th class="py-3 small text-uppercase text-muted">
                                Details
                            </th>

                            <th class="py-3 small text-uppercase text-muted">
                                Start
                            </th>

                            <th class="py-3 small text-uppercase text-muted">
                                Expected End
                            </th>

                            <th class="py-3 small text-uppercase text-muted">
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var loto in Model.Lotos)
                        {
                            <tr>

                                <!-- LOTO -->
                                <td class="px-4">

                                    <div class="fw-bold" style="color: #0b2d4d;">
                                        @loto.LotoNumber
                                    </div>

                                    <div class="small text-muted mt-1">
                                        @loto.LotoType
                                    </div>

                                </td>


                                <!-- Details -->
                                <td>
                                    <div class="d-flex flex-wrap gap-2">

                                        <span class="badge rounded-pill bg-light text-dark border">
                                            Plant: @loto.Plant?.Name
                                        </span>

                                        <span class="badge rounded-pill bg-light text-dark border">
                                            Dept: @loto.Department?.Name
                                        </span>

                                        <span class="badge rounded-pill bg-light text-dark border">
                                            Location: @loto.Location?.Name
                                        </span>

                                        <span class="badge rounded-pill bg-light text-dark border">
                                            Equipment: @loto.Equipment?.Name
                                        </span>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(loto.Description))
                                    {
                                        <div class="small text-muted mt-2">
                                            <strong>Description:</strong> @loto.Description
                                        </div>
                                    }
                                </td>


                                <!-- Start -->
                                <td data-order="@loto.StartDate.ToString("yyyy-MM-dd HH:mm:ss")">

                                    <span class="text-nowrap">
                                        @loto.StartDate.ToString("dd.MM.yyyy HH:mm")
                                    </span>

                                </td>


                                <!-- Expected End -->
                                <td data-order="@loto.ExpectedEndDate.ToString("yyyy-MM-dd HH:mm:ss")">

                                    <span class="text-nowrap">
                                        @loto.ExpectedEndDate.ToString("dd.MM.yyyy HH:mm")
                                    </span>

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (loto.Status == LotoStatus.Active)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                            Active
                                        </span>
                                    }
                                    else if (loto.Status == LotoStatus.Overdue)
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                            Overdue
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <div class="mb-2" style="font-size: 32px;">
                        ✓
                    </div>

                    <div class="fw-semibold">
                        No active LOTOs
                    </div>

                    <small>
                        You don't have any active or overdue LOTOs.
                    </small>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">

    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>


    @if (Model.Lotos.Any())
    {
        <script>

            $(document).ready(function() {

                $('#myActiveTable').DataTable({

                    pageLength: 10,

                    lengthMenu: [5, 10, 25, 50],

                    order: [[2, 'desc']],

                    columnDefs: [
                        {
                            orderable: false,
                            targets: [1, 4]
                        }
                    ],

                    language: {

                        search: "Search:",

                        lengthMenu: "Show _MENU_ records",

                        info: "Showing _START_ to _END_ of _TOTAL_ records",

                        infoEmpty: "Showing 0 to 0 of 0 records",

                        zeroRecords: "No matching records found",

                        paginate: {
                            first: "First",
                            last: "Last",
                            next: "Next",
                            previous: "Previous"
                        }

                    }

                });

            });

        </script>
    }

}